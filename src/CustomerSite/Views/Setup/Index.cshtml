@model Marketplace.SaaS.Accelerator.CustomerSite.Models.SetupViewModel
@{
    ViewData["Title"] = "Setup";
}
<link rel="stylesheet" href="~/css/setup.css" asp-append-version="true" />

<div class="container brand-activation setup-container" id="divSetup">

    <div class="mt20">
        <span class="cm-section-heading">@Model.SubscriptionName</span>
        <span class="setup-subhead">Plan @Model.PlanId</span>
    </div>

    <div class="mt20">
        @await Html.PartialAsync("_SetupChecklist", Model)
    </div>
</div>

@section Scripts {
    <script src="~/js/setup.js" asp-append-version="true"></script>
}
