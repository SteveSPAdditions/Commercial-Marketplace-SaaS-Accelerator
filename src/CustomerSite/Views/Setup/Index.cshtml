@model Marketplace.SaaS.Accelerator.CustomerSite.Models.SetupViewModel
@{
    ViewData["Title"] = "Setup";
}
<link rel="stylesheet" href="~/css/setup.css" asp-append-version="true" />

@await Html.PartialAsync("_BrandLanding")

<div class="container brand-activation setup-container" id="divSetup">

    @if (!string.IsNullOrEmpty(Model.FlashMessage))
    {
        <div class="alert @(Model.FlashIsError ? "alert-danger" : "alert-info") setup-flash" role="alert">
            @Model.FlashMessage
        </div>
    }

    <div class="text-white mt20">
        <span class="cm-section-heading">@Model.SubscriptionName</span>
        <span class="setup-subhead">Plan @Model.PlanId</span>
    </div>

    <ol class="setup-checklist mt20" data-subscription-id="@Model.AmpSubscriptionId">
        @await Html.PartialAsync("_Step1Active", Model)
        @await Html.PartialAsync("_Step2Region", Model)
        @await Html.PartialAsync("_Step3Consent", Model)
        @await Html.PartialAsync("_Step4Sites", Model)
    </ol>
</div>

@section Scripts {
    <script src="~/js/setup.js" asp-append-version="true"></script>
}
