@using Marketplace.SaaS.Accelerator.DataAccess.Entities
@model List<UsageLedgerRow>
@{
    ViewData["Title"] = "Metered usage";
    var utcNow = DateTime.UtcNow;
    bool tableExists = ViewBag.TableExists ?? false;
    UsageLedgerHealth health = ViewBag.Health as UsageLedgerHealth ?? new UsageLedgerHealth();
    string statusFilter = ViewBag.StatusFilter as string;
    var statuses = new[] { "pending", "accepted", "duplicate", "expired", "zero", "skipped" };
}

<div class="container">
    <div class="text-left mt40">
        <span class="cm-section-heading">Metered usage</span>
    </div>
    <p class="text-muted">
        Billing ledger written by the metering pipeline (read-only). For an emergency
        manual emission, use Manage Usage on the subscription itself &mdash; manual sends
        bypass this ledger.
    </p>

    @if (!tableExists)
    {
        <p class="text-muted mt20">No metered usage recorded yet.</p>
    }
    else
    {
        <div class="row mt20 g-2">
            <div class="col-md-auto">
                <div class="card text-center" style="min-width: 8rem;">
                    <div class="card-body p-2">
                        <h4 class="mb-0">@health.Pending</h4>
                        <small class="text-muted">pending</small>
                    </div>
                </div>
            </div>
            @if (health.PendingNearCliff > 0)
            {
                <div class="col-md-auto">
                    <div class="card text-center text-white bg-danger" style="min-width: 8rem;">
                        <div class="card-body p-2">
                            <h4 class="mb-0">@health.PendingNearCliff</h4>
                            <small>pending &gt; 18h &mdash; nearing 24h submission deadline</small>
                        </div>
                    </div>
                </div>
            }
            <div class="col-md-auto">
                <div class="card text-center" style="min-width: 8rem;">
                    <div class="card-body p-2">
                        <h4 class="mb-0">@health.Accepted</h4>
                        <small class="text-muted">accepted</small>
                    </div>
                </div>
            </div>
            <div class="col-md-auto">
                <div class="card text-center" style="min-width: 8rem;">
                    <div class="card-body p-2">
                        <h4 class="mb-0">@health.Duplicate</h4>
                        <small class="text-muted">duplicate</small>
                    </div>
                </div>
            </div>
            <div class="col-md-auto">
                <div class="card text-center @(health.Expired > 0 ? "text-white bg-danger" : "")" style="min-width: 8rem;">
                    <div class="card-body p-2">
                        <h4 class="mb-0">@health.Expired</h4>
                        <small class="@(health.Expired > 0 ? "" : "text-muted")">expired</small>
                    </div>
                </div>
            </div>
            <div class="col-md-auto">
                <div class="card text-center" style="min-width: 8rem;">
                    <div class="card-body p-2">
                        <h4 class="mb-0">@health.Zero</h4>
                        <small class="text-muted">zero</small>
                    </div>
                </div>
            </div>
            <div class="col-md-auto">
                <div class="card text-center @(health.Skipped > 0 ? "text-white bg-secondary" : "")" style="min-width: 8rem;">
                    <div class="card-body p-2">
                        <h4 class="mb-0">@health.Skipped</h4>
                        <small class="@(health.Skipped > 0 ? "" : "text-muted")">skipped</small>
                    </div>
                </div>
            </div>
        </div>

        <form method="get" class="row mt20 g-2 align-items-center">
            <div class="col-md-auto">
                <label for="status" class="fw-bold">Status</label>
            </div>
            <div class="col-md-3">
                <select id="status" name="status" class="form-control">
                    @if (string.IsNullOrEmpty(statusFilter))
                    {
                        <option value="" selected>all</option>
                    }
                    else
                    {
                        <option value="">all</option>
                    }
                    @foreach (var s in statuses)
                    {
                        if (string.Equals(s, statusFilter, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="cm-button-default">Filter</button>
            </div>
        </form>

        @if (Model == null || Model.Count == 0)
        {
            <p class="text-muted mt20">No ledger rows match.</p>
        }
        else
        {
            <div class="cm-panel-default mt20" style="overflow-x:auto">
                <table class="table table-striped table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Subscription</th>
                            <th>Period</th>
                            <th>Units</th>
                            <th>Active users</th>
                            <th>Threshold</th>
                            <th>Status</th>
                            <th>Event id</th>
                            <th>Accepted</th>
                            <th>Attempts</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model)
                        {
                            var badge = Badge(row, utcNow);
                            <tr>
                                <td>
                                    <a asp-controller="Home" asp-action="SubscriptionDetails" asp-route-subscriptionId="@row.AmpSubscriptionId">@row.AmpSubscriptionId</a>
                                </td>
                                <td>@row.PeriodStartUtc.ToString("yyyy-MM-dd") &ndash; @row.PeriodEndUtc.ToString("yyyy-MM-dd")</td>
                                <td>@row.Units</td>
                                <td>@(row.ActiveUserCount?.ToString() ?? "-")</td>
                                <td>@(row.ThresholdApplied?.ToString() ?? "-")</td>
                                <td><span class="badge @badge.Css">@badge.Label</span></td>
                                <td>@row.MsftUsageEventId</td>
                                <td>@(row.AcceptedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td>@row.Attempts</td>
                                <td>
                                    @row.SkipReason
                                    @if (!string.IsNullOrEmpty(row.LastResponse))
                                    {
                                        <details>
                                            <summary>response</summary>
                                            <pre style="white-space: pre-wrap; margin-bottom: 0;">@row.LastResponse</pre>
                                        </details>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@functions {
    public static (string Css, string Label) Badge(UsageLedgerRow row, DateTime utcNow)
    {
        if (row.IsNearCliff(utcNow))
        {
            return ("bg-danger", "pending (near cliff)");
        }

        return (row.Status?.ToLowerInvariant()) switch
        {
            "accepted" => ("bg-success", row.Status),
            "pending" => ("bg-warning text-dark", row.Status),
            "expired" => ("bg-danger", row.Status),
            "skipped" => ("bg-secondary", row.Status),
            "duplicate" => ("bg-info text-dark", row.Status),
            "zero" => ("bg-light text-dark border", row.Status),
            _ => ("bg-secondary", row.Status ?? "unknown"),
        };
    }
}
